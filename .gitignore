# 数据库文件（二进制，不应入git）
data/exmsys.db
data/exmsys*.db
data/*.db
data/*.db.*

# 备份文件
data/*.backup*

# 多用户数据（每用户私有库 + 账户映射，属运行期数据）
data/users/
data/master/
data/archive/
data/accounts.json
data/user_mapping.json

# Python
__pycache__/
*.pyc

# 临时文件
temp/
tmp/
logs/

# Streamlit 配置
#   config.toml 是纯配置（云端部署需要它，所以要进仓库）
#   secrets.toml 含 Supabase 数据库密码 —— 绝不进仓库
.streamlit/*
!.streamlit/config.toml

# 本地环境变量文件（含 Supabase 连接串）—— 绝不进仓库
.env
